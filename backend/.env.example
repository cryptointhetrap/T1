PORT=8787
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional — where uploaded .ics feed data is written. Defaults to
# ./data/feeds relative to the process's working directory.
FEED_DATA_DIR=./data/feeds
# Optional — where per-athlete Strava webhook event timestamps are
# written. Defaults to ./data/webhooks relative to the process's working
# directory.
WEBHOOK_DATA_DIR=./data/webhooks
# Optional — must match the verify_token you pass when creating the
# Strava push subscription (see backend/README.md). Only used for that
# one-time handshake, not required for normal operation.
STRAVA_WEBHOOK_VERIFY_TOKEN=choose_any_random_string
# Optional — where invite-code group data (for the in-app "Compare"
# feature) is written. Defaults to ./data/groups relative to the
# process's working directory.
GROUPS_DATA_DIR=./data/groups
# Optional — where registered APNs device tokens are written. Defaults to
# ./data/push relative to the process's working directory.
PUSH_DATA_DIR=./data/push
# Optional, all four required together to turn on push notifications (AI
# workout reviews) — see backend/README.md → "Push notifications setup".
# Commented out by default: leave them this way and everything else in
# this backend works exactly the same, just without that one feature.
# Uncomment and fill in all four with real values to turn it on.
#APNS_TEAM_ID=your_apple_developer_team_id
#APNS_KEY_ID=your_apns_auth_key_id
#APNS_AUTH_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
#APNS_BUNDLE_ID=com.trainingmonitor.app
